{
  "name": "gakumasu-timeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "measure:layout": "node scripts/measure-timeline-layout.mjs",
    "generate:data": "node scripts/generate-data.mjs",
    "story:id": "node scripts/create-story-id.mjs",
    "validate:data": "node scripts/generate-data.mjs --check && node scripts/validate-data.mjs",
    "verify": "npm run validate:data && npm run test && npm run build",
    "build": "vite build",
    "deploy": "node -e \"console.error('Deployment is handled by GitHub Actions to rectaris/rectaris.github.io under /timeline/.'); process.exit(1)\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.59.1",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
