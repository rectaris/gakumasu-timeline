{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "gakumasu-timeline-curiretas",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "curiretas.com/gakumastool/timeline/*",
      "zone_name": "curiretas.com"
    }
  ],
  "assets": {
    "directory": "./.cloudflare-assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
