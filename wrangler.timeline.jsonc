{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gakumasu-timeline-curiretas",
  "main": "workers/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "curiretas.com/gakumastool/timeline/*",
      "zone_name": "curiretas.com"
    }
  ],
  "assets": {
    "directory": "./.cloudflare-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/authoring/*",
      "/gakumastool/timeline/api/authoring/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "TIMELINE_DB",
      "database_name": "gakumasu-timeline-prod",
      "database_id": "ab1ff388-0a9b-44ce-86d8-c885d425c635",
      "migrations_dir": "./workers/migrations"
    }
  ],
  "vars": {
    "DISCORD_CONTRIBUTOR_ROLE_IDS": "1536729023382683728",
    "DISCORD_REVIEWER_ROLE_IDS": "1536729104764895333"
  },
  "services": [
    {
      "binding": "ACCOUNT_SERVICE",
      "service": "curiretas-account"
    },
    {
      "binding": "DISCORD_MEMBERSHIP_SERVICE",
      "service": "curiretas-account",
      "entrypoint": "DiscordGuildMembershipService"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
